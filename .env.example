# Docker 镜像配置
IMAGE_TAG=x-agent:latest

# Anthropic Claude 配置
ANTHROPIC_BASE_URL=https://openai.qiniu.com
ANTHROPIC_AUTH_TOKEN=sk-xxx
ANTHROPIC_MODEL=claude-4.5-sonnet
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-4.5-sonnet
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-4.5-haiku
ANTHROPIC_SMALL_FAST_MODEL=claude-4.5-haiku

# 微信企业机器人配置 (可选)
WECHAT_WEBHOOK_KEY=your_wechat_webhook_key_here

# Redis 配置
REDIS_HOST=localhost:6379

# 服务器配置
SERVER_PORT=8080
